# =====================================================================
# Orbit 积分后端环境变量模板
# 使用方法：复制本文件为 .env，逐项填写。部署时同样把 .env 放在 backend/ 目录。
# 注意：.env 含密钥，已被 .gitignore 排除，绝不能提交到 Git 或发给任何人。
# =====================================================================

# ---- 服务 ----
# 监听端口（Docker 部署时容器内端口，对外映射在 docker-compose.yml 里改）
PORT=8080
# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ---- 登录令牌 ----
# JWT 签名密钥：随机长字符串（生成方法见 README“生成随机密钥”一节），务必更换！
JWT_SECRET=please-change-me-to-a-long-random-string
# 令牌有效期，到期后 App 需重新登录
JWT_EXPIRES_IN=7d

# ---- 数据库 ----
# SQLite 文件路径（Docker 里挂载到宿主机 ./data 目录，删容器不丢数据）
DATABASE_PATH=./data/orbit-points.db

# ---- 管理员账号 ----
# 首次启动自动创建；之后修改密码需删除数据库里该用户或手工更新
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me-too

# ---- OneAPI 网关 ----
# 后端访问 OneAPI 的内网地址。同 Docker 网络时通常形如 http://one-api:3000
ONEAPI_BASE_URL=http://127.0.0.1:3000
# 下发给 iOS 客户端直连对话的公网地址（必须 HTTPS，例如 https://api.your-domain.com）
ONEAPI_PUBLIC_BASE_URL=https://api.your-domain.com
# OneAPI 管理员的“系统访问令牌”：OneAPI 网页登录管理员 -> 个人设置 -> 生成令牌
ONEAPI_ADMIN_TOKEN=
# 仅 new-api 分支需要：填管理员在 OneAPI 里的数字用户 ID（通常是 1）；one-api 原版留空
ONEAPI_ADMIN_USER_ID=
# 1 积分 = 多少 OneAPI quota。OneAPI 默认 500000 quota = 1 美元，保持默认即可
ONEAPI_QUOTA_PER_POINT=500000
# 可选：下发给 App 的默认模型名（方便客户端展示，不填则不下发该字段）
# ONEAPI_DEFAULT_MODEL=glm-4v-plus

# ---- 积分包：App Store 商品 ID -> 积分数 ----
# 必须与 App Store Connect 里配置的消耗型商品 ID 完全一致
POINT_PACKS={"com.yourcompany.app.points50":50,"com.yourcompany.app.points250":250}

# ---- 苹果内购 ----
# App 的 Bundle ID（与 Xcode 工程一致）
APPLE_BUNDLE_ID=com.yourcompany.app
# App 专用共享密钥：App Store Connect -> App 信息 -> App 专用共享密钥 -> 生成
APPLE_SHARED_SECRET=

# 下面三项一般不用改（冒烟测试会自动指向本地模拟服务）
# APPLE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
# APPLE_SANDBOX_VERIFY_URL=https://sandbox.itunes.apple.com/verifyReceipt
# APPLE_ROOT_CA_PATH=./certs/AppleRootCA-G3.cer

# ---- 注册赠送 ----
# 新用户注册赠送的体验积分（0 = 不赠送；赠送会在注册后立即创建 OneAPI 钱包）
# 注意：注册接口本身不阻塞等 OneAPI，赠送实际发生在该用户下一次任意积分操作时
REGISTRATION_BONUS_POINTS=0
